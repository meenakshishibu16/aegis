# Copy to .env and adjust. All values are optional.
OLLAMA_URL=http://localhost:11434
AGENT_MODEL=qwen2.5:3b
# Set true to replay recorded LLM responses (backend/cassettes) instead of calling Ollama.
REPLAY_MODE=false

CLASSIFIER_ENABLED=true
CLASSIFIER_MODEL=protectai/deberta-v3-base-prompt-injection-v2
BLOCK_THRESHOLD=0.85
SANITIZE_THRESHOLD=0.5
MAX_STEPS=8
